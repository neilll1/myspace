.btn,.nav,.chk,.tg,.av,.prof{transition:background-color .18s,color .18s,border-color .18s,box-shadow .18s,transform .18s}
.btn:active{transform:scale(.97)}
tbody tr{transition:background-color .15s}tbody tr:hover{background:var(--th)}
.lk{color:#2F6FED;font-weight:600;text-decoration:none}[data-theme=dark] .lk{color:#6EA2F5}.lk:hover{text-decoration:underline}
.fld small{display:block;margin-top:3px;font-size:11px}
