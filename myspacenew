#view.in>*:not(.mod),#view.in .mod>*{animation:vin .34s cubic-bezier(.2,.7,.2,1) both}
#view.in>:nth-child(2),#view.in .mod>:nth-child(2){animation-delay:.05s}
#view.in>:nth-child(3),#view.in .mod>:nth-child(3){animation-delay:.1s}
#view.in>:nth-child(n+4),#view.in .mod>:nth-child(n+4){animation-delay:.15s}
